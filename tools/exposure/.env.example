# Credentials for the Exposure Report pipeline.
#
# Copy to .env (gitignored). In the Claude Code web environment, set these as
# environment variables on the environment instead — that way they never pass
# through a chat transcript.

# Firecrawl — crawling the subject's and peers' public surface
FIRECRAWL_API_KEY=

# Exa — find-similar for competitive-set discovery (the make-or-break stage)
EXA_API_KEY=

# Perplexity — sourced synthesis on peer AI announcements
PERPLEXITY_API_KEY=

# DataForSEO — category demand signals. Basic auth: login + password, not a key.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic — claim extraction from crawled pages (arrangement only, never facts)
ANTHROPIC_API_KEY=

# Per-run spend ceiling in USD. The pipeline aborts rather than exceeding it.
EXPOSURE_RUN_BUDGET_USD=5
