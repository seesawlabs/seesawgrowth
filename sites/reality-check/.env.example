# Scheduler — Cal.com event link, hosted by Jeff, who adds Calvin to the
# invite when both should be on it. Single host on purpose: a collective event
# only offers times both are free, and this keeps the 10-3 CT window open.
# See README for the priority-window setup and the Free-vs-Busy gotcha.
PUBLIC_CAL_LINK=https://cal.com/seesawlabs/reality-check

# Magic links for released briefs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value must be set on Vercel and on the machine that runs the release
# script, or minted links will not verify. It also derives the stored filename,
# so rotating it orphans briefs already released.
EXPOSURE_LINK_SECRET=

# Public prefix of the store the site reads released briefs from. Unset means
# the disk store, which only resolves on the machine holding the files.
EXPOSURE_REPORT_BASE_URL=

# Operator machine only: used to build the /book-call link written into briefs.
PUBLIC_SITE_ORIGIN=https://seesawgrowth.vercel.app

# Set these when project 07 (CRM, email, attribution) lands. The endpoint
# degrades gracefully while they're unset — it logs and skips.
HUBSPOT_TOKEN=
RESEND_TOKEN=
SLACK_WEBHOOK=
ANTHROPIC_API_KEY=

# Analytics (optional)
PUBLIC_PLAUSIBLE_DOMAIN=
