---
/* ---------------------------------------------------------------------------
   The Exposure Report request form.

   FOUR REQUIRED FIELDS, THREE OPTIONAL, and every one of them changes the
   output — see src/lib/exposure-intake.ts for why each exists and what the live
   runs said about it. The short version: the one-liner and the competitors are
   the two fields that decide whether the report is sharp or generic. Naming two
   competitors took a real run from one peer with dated evidence to three, and
   from 90% coverage to 100%.

   WE DO NOT ASK FOR VOLUMES. Case counts, cycle times, headcount. Those are the
   blanks the report leaves open on purpose; they are the agenda for the call.

   THE CONFIRMATION IS WHERE THE WAIT GETS SPENT. A run takes about two minutes
   measured end to end, which is an awkward amount of time to stare at — so the
   confirmation puts the booking calendar in front of them immediately rather
   than after. Someone who books while the report builds is the outcome we want
   anyway, and someone who doesn't has lost nothing.

   Validation is shared with the endpoint rather than duplicated, so the message
   a visitor sees and the rule the server enforces cannot drift.
--------------------------------------------------------------------------- */
import { MAX_COMPETITORS, ONE_LINER_MAX, TRIGGER_MAX } from '../lib/exposure-intake';

const calLink = import.meta.env.PUBLIC_CAL_LINK ?? '/book';
---

<form class="xr" id="xr-form" novalidate>
  <div class="xr__row">
    <label class="xr__field">
      <span class="xr__label">Your name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label class="xr__field">
      <span class="xr__label">Work email</span>
      <input name="email" type="email" autocomplete="email" inputmode="email" required />
      <span class="xr__help">Where the private link goes.</span>
    </label>
  </div>

  <div class="xr__row">
    <label class="xr__field">
      <span class="xr__label">Company</span>
      <input name="company" type="text" autocomplete="organization" required />
    </label>
    <label class="xr__field">
      <span class="xr__label">Website</span>
      <input name="website" type="text" inputmode="url" placeholder="yourcompany.com" required />
    </label>
  </div>

  <label class="xr__field xr__field--wide">
    <span class="xr__label">In one line, what does your company do?</span>
    <textarea name="oneLiner" rows="2" maxlength={ONE_LINER_MAX} required
      placeholder="Specialty pharmacy handling prior authorization and patient onboarding for prescribers"></textarea>
    <span class="xr__help">
      This is what we search on to find companies like yours. Most homepages
      describe a feeling rather than a business, so we&rsquo;d rather have your
      version, however blunt.
    </span>
  </label>

  <fieldset class="xr__field xr__field--wide xr__fieldset">
    <legend class="xr__label">
      Who are your closest competitors?
      <span class="xr__opt">optional, up to {MAX_COMPETITORS}</span>
    </legend>
    <div class="xr__comps">
      <input name="competitor" type="text" placeholder="competitor.com" aria-label="Competitor 1" />
      <input name="competitor" type="text" placeholder="competitor.com" aria-label="Competitor 2" />
      <input name="competitor" type="text" placeholder="competitor.com" aria-label="Competitor 3" />
    </div>
    <span class="xr__help">
      You know your market better than our search does. We&rsquo;ll look up
      anyone you name here.
    </span>
  </fieldset>

  <label class="xr__field xr__field--wide">
    <span class="xr__label">
      What&rsquo;s driving this right now?
      <span class="xr__opt">optional</span>
    </span>
    <textarea name="trigger" rows="3" maxlength={TRIGGER_MAX}
      placeholder="A board question, a competitor announcement, a process that keeps breaking — one line is plenty."></textarea>
    <span class="xr__help">Steers what the report leads with.</span>
  </label>

  <label class="xr__check">
    <input name="wantsCall" type="checkbox" />
    <span>
      Also put an hour in the diary to go through it — including where we got it
      wrong.
    </span>
  </label>

  <button class="btn xr__submit" type="submit">Send me the report</button>

  <p class="xr__error" id="xr-error" hidden role="alert"></p>
</form>

<div class="xr__done" id="xr-done" hidden tabindex="-1">
  <p class="xr__doneKicker" id="xr-doneKicker">Request received</p>
  <h3 id="xr-doneHead">We&rsquo;ll email you a link shortly</h3>
  <p id="xr-doneBody">
    We&rsquo;re reading your site now, then looking up companies like yours.
    One email, one private link. No need to keep this page open.
  </p>

  <div class="xr__while">
    <p class="xr__whileH">While that happens</p>
    <p class="xr__whileB">
      We write it from the outside, so some of it will be wrong. The hour is
      where you put us straight and fill in the blanks.
    </p>
    <a class="btn" id="xr-bookLink" href={calLink}>Book the hour</a>
  </div>

  <p class="xr__thin" id="xr-thin" hidden>
    If there isn&rsquo;t enough public information on your company to say
    anything useful, we&rsquo;ll tell you that rather than pad it out.
  </p>
</div>

<style>
  .xr { display: grid; gap: var(--sp-5); max-width: 44rem; }
  .xr__row { display: grid; gap: var(--sp-5); }
  @media (min-width: 34rem) {
    .xr__row { grid-template-columns: 1fr 1fr; }
  }
  .xr__field { display: grid; gap: var(--sp-2); }
  .xr__fieldset { border: 0; padding: 0; margin: 0; }
  .xr__label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    flex-wrap: wrap;
    padding: 0;
  }
  .xr__opt { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted); font-weight: 400; }
  .xr__help {
    font-size: var(--text-sm);
    line-height: var(--lh-snug);
    color: var(--muted);
    max-width: 60ch;
  }
  .xr input[type='text'],
  .xr input[type='email'],
  .xr textarea {
    font-family: inherit;
    font-size: var(--text-md);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: var(--sp-3) var(--sp-4);
    width: 100%;
    transition: border-color var(--dur-normal) var(--ease-out);
  }
  .xr textarea { resize: vertical; line-height: var(--lh-normal); }
  .xr input:focus-visible,
  .xr textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .xr [aria-invalid='true'] { border-color: var(--red-500); }

  .xr__comps { display: grid; gap: var(--sp-3); }
  @media (min-width: 34rem) {
    .xr__comps { grid-template-columns: repeat(3, 1fr); }
  }

  .xr__check {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    font-size: var(--text-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
    padding: var(--sp-4);
    background: var(--bg-sunk);
    border-radius: var(--radius-md);
    max-width: 60ch;
  }
  .xr__check input { margin-top: 0.15rem; accent-color: var(--accent); flex: none; }

  .xr__submit { justify-self: start; }

  .xr__error {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--red-700);
    background: var(--red-50);
    border-radius: var(--radius-md);
    padding: var(--sp-3) var(--sp-4);
    max-width: 60ch;
  }

  .xr__done { max-width: 44rem; }
  .xr__done:focus-visible { outline: none; }
  .xr__doneKicker {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--sp-3);
  }
  .xr__done h3 {
    font-size: clamp(var(--text-2xl), 3.4vw, var(--text-3xl));
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-tight);
    margin: 0 0 var(--sp-4);
    text-wrap: balance;
  }
  .xr__done > p:not(.xr__doneKicker) {
    margin: 0 0 var(--sp-6);
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: var(--lh-relaxed);
    max-width: 58ch;
  }
  .xr__while {
    padding: var(--sp-6);
    background: var(--bg-sunk);
    border-radius: var(--radius-xl);
    border: 1px solid var(--rule);
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }
  .xr__whileH {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .xr__whileB {
    margin: 0;
    color: var(--ink-2);
    line-height: var(--lh-relaxed);
    max-width: 54ch;
  }
  .xr__thin {
    margin: var(--sp-6) 0 0 !important;
    font-size: var(--text-sm) !important;
    color: var(--muted) !important;
  }
</style>

<script>
  const form = document.getElementById('xr-form');
  const done = document.getElementById('xr-done');
  const errorBox = document.getElementById('xr-error');
  const submit = form?.querySelector('button[type="submit"]');
  const MAILTO = 'mailto:calvin@seesawlabs.com?subject=AI%20Exposure%20Report%20request';

  function fail(message, withMailto) {
    if (!errorBox) return;
    errorBox.textContent = message;
    if (withMailto) {
      const a = document.createElement('a');
      a.href = MAILTO;
      a.textContent = ' Email us instead.';
      errorBox.appendChild(a);
    }
    errorBox.hidden = false;
    if (submit instanceof HTMLButtonElement) {
      submit.disabled = false;
      submit.textContent = 'Send me the report';
    }
  }

  function setInvalid(name, invalid) {
    const el = form?.querySelector(`[name="${name}"]`);
    if (el instanceof HTMLElement) el.setAttribute('aria-invalid', invalid ? 'true' : 'false');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (errorBox) errorBox.hidden = true;

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      company: String(data.get('company') ?? '').trim(),
      website: String(data.get('website') ?? '').trim(),
      oneLiner: String(data.get('oneLiner') ?? '').trim(),
      competitors: data.getAll('competitor').map((c) => String(c).trim()).filter(Boolean),
      trigger: String(data.get('trigger') ?? '').trim(),
      wantsCall: data.get('wantsCall') === 'on',
      attribution: {},
    };

    /* Client-side check mirrors the server's required set. The server validates
       again and its messages win — this only saves a round trip. */
    let firstBad = null;
    for (const field of ['name', 'email', 'company', 'website', 'oneLiner']) {
      const empty = !payload[field];
      setInvalid(field, empty);
      if (empty && !firstBad) firstBad = field;
    }
    if (firstBad) {
      fail('Name, email, company, website and the one-liner are all needed before we can start.', false);
      form.querySelector(`[name="${firstBad}"]`)?.focus();
      return;
    }

    try {
      payload.attribution = JSON.parse(sessionStorage.getItem('ssl_attr') ?? '{}');
    } catch {
      /* private mode — attribution is best-effort and never blocks a submit */
    }

    if (submit instanceof HTMLButtonElement) {
      submit.disabled = true;
      submit.textContent = 'Sending…';
    }

    try {
      const res = await fetch('/api/exposure-request', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        if (res.status === 422 && Array.isArray(body.errors) && body.errors.length) {
          for (const e of body.errors) setInvalid(e.field, true);
          fail(body.errors[0].message, false);
          form.querySelector(`[name="${body.errors[0].field}"]`)?.focus();
          return;
        }
        /* 404 means the server adapter is not deployed. Say so plainly rather
           than pretending the request landed — the qualifier lost submissions
           to exactly this silence. */
        fail(
          res.status === 404
            ? 'Our form endpoint is not reachable right now, so this did not send.'
            : 'Something went wrong at our end, so this did not send.',
          true
        );
        return;
      }

      const body = await res.json().catch(() => ({}));
      form.hidden = true;
      if (done) {
        done.hidden = false;

        /* One line for both delivery modes. Promising "two minutes" or "a
           business day" invites a visitor to time us, and the honest answer
           varies with whether a person is still reading each report before it
           goes out. "Shortly" is true either way, and the email is the
           contract. */
        const link = document.getElementById('xr-bookLink');
        if (body.bookingUrl && link instanceof HTMLAnchorElement) link.href = body.bookingUrl;

        const thin = document.getElementById('xr-thin');
        if (thin) thin.hidden = false;

        done.focus();
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch {
      fail('That did not send — you may be offline.', true);
    }
  });
</script>
