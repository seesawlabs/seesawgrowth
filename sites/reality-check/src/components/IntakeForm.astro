---
/* ---------------------------------------------------------------------------
   The intake: two ways in, one form, one calendar.

   BOOK FIRST OR ANSWER FIRST. A visitor who wants a time on the calendar can
   have one before typing anything; the questions come after, aimed by the
   knowledge that a call already exists. A visitor who would rather explain
   first answers the form and books on the confirmation. Both paths submit the
   same payload. Three open questions, in their words, aim the research; the
   company name, category and competitive set are inferred from the website.

   WHAT IS NOT ASKED ANY MORE. Revenue band and "where are you with this" are
   gone: they existed to feed a score that decided who was offered the session,
   and nobody is gated now. Every lead is researched and the team decides. The
   one open question that stays is what they have already tried, because it
   aims the research better than any dropdown did.

   NO CHARACTER LIMITS ON THE OPEN TEXT. Someone who wants to write four
   paragraphs about what they tried is the best lead on the page. The only
   ceiling is a server-side abuse cap no human will reach.

   THE DEFAULT PATH NEEDS NO JAVASCRIPT TO BE VISIBLE. The form shows by
   default; the book-first pane is what the script reveals. A visitor whose
   script fails still sees a working form.
--------------------------------------------------------------------------- */
import { ROLES } from '../lib/qualifier';
import { OPEN_QUESTIONS } from '../lib/intake';
---

<section class="q" id="qualifier" aria-labelledby="q-title">
  <div class="q__head">
    <p class="eyebrow">Free · 45 minutes · one written recommendation</p>
    <h2 id="q-title">Book your 45 minutes</h2>
    <p class="lede">
      A few questions first, then pick a time on the next screen. Shortly after
      the call you get the report: the one thing we&rsquo;d build first, and why.
    </p>
  </div>

  <form class="q__form" id="q-form" novalidate>

    <!-- ---------------- step 1 ---------------- -->
    <div class="q__step is-on" data-step="1">
      <p class="q__stepline">Step 1 of 2</p>

      <fieldset class="q__set">
        <legend>What&rsquo;s your role?</legend>
        <div class="q__opts" id="q-roles">
          {ROLES.map((r) => (
            <label class="q__opt">
              <input type="radio" name="role" value={r.value} />
              <span>{r.label}</span>
            </label>
          ))}
        </div>
        <div class="q__row" id="q-title-row" hidden>
          <label class="q__lab" for="q-role-title">What&rsquo;s your title?</label>
          <input type="text" id="q-role-title" name="roleTitle" placeholder="e.g. Chief Medical Officer" />
        </div>
        <p class="q__err" id="q-err-role" role="alert">Pick the closest one.</p>
      </fieldset>

      {OPEN_QUESTIONS.map((q, i) => (
        <fieldset class="q__set">
          <legend>
            {q.label}
            <span class="q__optional">Optional</span>
          </legend>
          {i === 2 && (
            <p class="q__hint">
              We&rsquo;d rather not send you something you rejected two years ago.
            </p>
          )}
          <textarea id={`q-${q.key}`} name={q.key} rows="4"></textarea>
        </fieldset>
      ))}

      <div class="q__btns">
        <button type="button" class="btn" data-go="2">Continue</button>
      </div>
    </div>

    <!-- ---------------- step 2 ---------------- -->
    <div class="q__step" data-step="2">
      <p class="q__stepline">Step 2 of 2</p>

      <div class="q__row">
        <label class="q__lab" for="q-name">Full name</label>
        <input type="text" id="q-name" name="name" autocomplete="name" />
      </div>

      <div class="q__row">
        <label class="q__lab" for="q-email">Work email</label>
        <input type="email" id="q-email" name="email" autocomplete="email"
          placeholder="you@company.com" />
      </div>

      <div class="q__row">
        <label class="q__lab" for="q-website">Company website</label>
        <input type="text" id="q-website" name="website" placeholder="company.com" />
        <p class="q__hint" id="q-website-hint">Where the research starts.</p>
      </div>

      <p class="q__err" id="q-err-contact" role="alert">
        We need your name, work email, and website.
      </p>

      <div class="q__btns">
        <button type="submit" class="btn" id="q-submit">Book the call</button>
        <button type="button" class="btn btn--ghost" data-go="1">Back</button>
      </div>

      <p class="q__privacy">
        We&rsquo;ll only use this to prepare for the call and write your report. <a
          href="/privacy">Privacy</a>.
      </p>
    </div>
  </form>

  <!-- ---------------- outcomes ---------------- -->

  <!-- Answered first: now book. -->
  <div class="q__out" data-out="booked" hidden>
    <h3>Got it. Now pick your 45 minutes.</h3>
    <p>
      We&rsquo;ll research your company before we talk, and the report follows
      shortly after the call. Confirmation and
      details go to <strong data-fill="email">the address you gave us</strong>.
    </p>

    <div class="q__next">
      <p class="q__lab-sm" style="margin-top:0">Book the call</p>
      <div class="q__sched" id="q-sched">
        <p class="q__sched-note">
          Scheduler embed - Cal.com, hosted by the team.
          <br />Set <code>PUBLIC_CAL_LINK</code> to go live.
        </p>
      </div>
      <p class="q__sched-alt" id="q-sched-alt" hidden>
        Calendar not loading? <a href="/book-call" id="q-sched-alt-link" target="_blank" rel="noopener">Open it in a new tab</a>.
      </p>
    </div>
  </div>

  <div class="q__out" data-out="error" hidden>
    <h3>That didn&rsquo;t go through.</h3>
    <p>
      Something on our end failed, not yours. Email <a
        href="mailto:hello@seesawlabs.com">hello@seesawlabs.com</a> and we&rsquo;ll
      sort it out, or try again in a minute.
    </p>
  </div>
</section>

<style>
  .q {
    max-width: var(--page-narrow);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .q__head { margin-bottom: var(--sp-8); }
  .q__head h2 {
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .q__head .lede { margin: 0; }

  .q__step { display: none; scroll-margin-top: calc(84px + var(--sp-6)); }
  .q__step.is-on { display: block; }
  .q__out { scroll-margin-top: calc(84px + var(--sp-6)); }

  .q__stepline {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-6);
  }

  .q__set { border: 0; margin: 0 0 var(--sp-8); padding: 0; }
  .q__set legend {
    font-size: var(--text-xl);
    font-weight: 600;
    padding: 0;
    margin-bottom: var(--sp-2);
    line-height: var(--lh-snug);
  }
  /* Always its own line under the question, never trailing the last word.
     Inline it wrapped alone on long legends and read as an orphan. */
  .q__optional {
    display: block;
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--sp-1);
  }
  .q__hint, .q__set legend, .q__lab { text-wrap: pretty; }
  .q__hint {
    font-size: var(--text-md);
    color: var(--muted);
    margin-bottom: var(--sp-4);
  }

  .q__opts { display: flex; flex-direction: column; gap: var(--sp-2); }
  .q__opt { position: relative; display: block; }
  .q__opt input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .q__opt span {
    display: block;
    padding: var(--sp-4) var(--sp-5);
    min-height: 48px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    font-size: var(--text-md);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .q__opt span:hover { border-color: var(--neutral-300); }
  .q__opt input:checked + span {
    border-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .q__opt input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .q__row { margin-bottom: var(--sp-5); }
  .q__lab {
    display: block;
    font-size: var(--text-md);
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }
  .q__form input[type='text'],
  .q__form input[type='email'],
  .q__form textarea,
  .q__form select {
    width: 100%;
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--lh-normal);
  }
  .q__form textarea { resize: vertical; min-height: 132px; }
  .q__form select { cursor: pointer; }
  .q__form input:focus,
  .q__form textarea:focus,
  .q__form select:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: var(--accent);
  }
  .q__form input.is-prefilled { border-style: dashed; }

  .q__err {
    display: none;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--red-700);
    margin-top: var(--sp-3);
  }
  .q__err.is-on { display: block; }

  .q__btns {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-8);
  }
  .q__privacy {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-top: var(--sp-5);
  }

  /* -- outcomes and the calendar -- */
  .q__out h3 {
    font-size: clamp(var(--text-2xl), 3.6vw, var(--text-4xl));
    margin-bottom: var(--sp-4);
  }
  .q__out p { color: var(--ink-2); margin-bottom: var(--sp-4); }
  .q__lab-sm {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--sp-6) 0 var(--sp-3);
  }

  .q__sched {
    border: 1px dashed var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--sp-10) var(--sp-5);
    text-align: center;
    background: var(--bg-sunk);
  }
  .q__sched-note {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0;
  }
  /* Once Cal's embed mounts it owns this box: drop the placeholder chrome and
     give it a height to lay out in, since the inline embed takes the size of
     its container rather than declaring its own. */
  .q__sched.is-live {
    border: 0;
    padding: 0;
    background: transparent;
    min-height: 640px;
    overflow: hidden;
  }

  .q__next {
    margin: var(--sp-8) 0;
    padding: var(--sp-6) var(--sp-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-sunk);
  }
  .q__next .q__sched { background: var(--bg); }
  .q__sched-alt {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: var(--sp-4) 0 0;
    text-align: center;
  }

</style>

<script>
  import { emailDomain, isFreeEmail } from '../lib/qualifier';
  import type { Answers } from '../lib/qualifier';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;
  const form = $<HTMLFormElement>('#q-form');
  if (form) {
    const pick = (name: string): string | null => {
      const el = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      return el ? el.value : null;
    };
    const val = (id: string): string => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
      return el ? el.value.trim() : '';
    };

    /* ---------------------------------------------------------------------
       The scheduler.

       Pointing an iframe at a Cal.com booking URL is not an embed — Cal renders
       its meta column and no calendar. Cal's embed API mounts the real booker.
       Loaded on demand rather than on page load: most visitors never reach a
       calendar, and this is a third-party script.
    --------------------------------------------------------------------- */
    const CAL_EMBED_SRC = 'https://app.cal.com/embed/embed.js';

    /* Cal's own loader stub, kept close to their published snippet. It queues
       calls made before embed.js arrives. */
    const loadCal = () => {
      const w = window as any;
      if (w.Cal) return;
      const push = (a: any, ar: any) => a.q.push(ar);
      w.Cal = function () {
        const cal = w.Cal;
        const ar = arguments as any;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          document.head.appendChild(document.createElement('script')).src = CAL_EMBED_SRC;
          cal.loaded = true;
        }
        if (ar[0] === 'init') {
          const api: any = function () { push(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            push(cal.ns[namespace], ar);
            push(cal, ['initNamespace', namespace]);
          } else push(cal, ar);
          return;
        }
        push(cal, ar);
      };
    };

    let calInitialised = false;
    const mountScheduler = (slot: HTMLElement, bookingUrl: string) => {
      /* PUBLIC_CAL_LINK is a full URL, because /book-call redirects to it and
         the emails link it. Cal's embed wants just the path. */
      let calLink: string;
      try {
        calLink = new URL(bookingUrl).pathname.replace(/^\/+|\/+$/g, '');
      } catch {
        return;
      }
      if (!calLink) return;

      slot.innerHTML = '';
      slot.classList.add('is-live');
      try {
        loadCal();
        const Cal = (window as any).Cal;
        if (!calInitialised) {
          Cal('init');
          calInitialised = true;
        }
        Cal('inline', { elementOrSelector: slot, calLink, config: { layout: 'month_view' } });
      } catch {
        slot.classList.remove('is-live');
      }
    };

    /* Fetched at request time rather than inlined at build, so repointing the
       calendar is a dashboard change and not a deploy. */
    let bookingUrlPromise: Promise<string | null> | null = null;
    const getBookingUrl = () => {
      if (!bookingUrlPromise) {
        bookingUrlPromise = fetch('/api/booking')
          .then((r) => (r.ok ? r.json() : { bookingUrl: null }))
          .then((d) => (d && typeof d.bookingUrl === 'string' ? d.bookingUrl : null))
          .catch(() => null);
      }
      return bookingUrlPromise;
    };

    const head = $<HTMLDivElement>('.q__head');

    /* ----------------------------- fields ----------------------------- */
    let websiteSource: 'blank' | 'prefilled' | 'user_corrected' = 'blank';
    const website = $<HTMLInputElement>('#q-website');
    const websiteHint = $<HTMLParagraphElement>('#q-website-hint');

    const prefillWebsite = () => {
      const d = emailDomain(val('q-email'));
      const usable = d && d.includes('.') && !isFreeEmail(d);
      if (usable && (website.value === '' || websiteSource === 'prefilled')) {
        website.value = d;
        website.classList.add('is-prefilled');
        websiteSource = 'prefilled';
        websiteHint.textContent = 'Pre-filled from your email. Correct it if that’s not right.';
      } else if (!usable && websiteSource === 'prefilled') {
        website.value = '';
        website.classList.remove('is-prefilled');
        websiteSource = 'blank';
        websiteHint.textContent = 'Where the research starts.';
      }
    };
    $<HTMLInputElement>('#q-email').addEventListener('blur', prefillWebsite);
    $<HTMLInputElement>('#q-email').addEventListener('change', prefillWebsite);
    website.addEventListener('input', () => {
      if (websiteSource === 'prefilled') {
        websiteSource = 'user_corrected';
        website.classList.remove('is-prefilled');
        websiteHint.textContent = 'Where the research starts.';
      }
    });

    $<HTMLDivElement>('#q-roles').addEventListener('change', () => {
      $<HTMLDivElement>('#q-title-row').hidden = pick('role') !== 'other';
    });

    /* ------------------------------ steps ----------------------------- */
    const clearErrs = () =>
      form.querySelectorAll('.q__err').forEach((e) => e.classList.remove('is-on'));
    const showErr = (id: string) => document.getElementById(id)?.classList.add('is-on');

    const show = (n: number) => {
      let active: HTMLElement | null = null;
      form.querySelectorAll<HTMLElement>('.q__step').forEach((s) => {
        const on = s.dataset.step === String(n);
        s.classList.toggle('is-on', on);
        if (on) active = s;
      });
      /* Land on the step itself, not the form: the form's top is the
         previous step's scroll position. scroll-margin-top on .q__step keeps
         it clear of the sticky header. */
      (active ?? form).scrollIntoView({ block: 'start', behavior: 'smooth' });
    };

    form.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => {
      b.addEventListener('click', () => {
        clearErrs();
        const target = Number(b.dataset.go);
        if (target === 2 && !pick('role')) {
          showErr('q-err-role');
          return;
        }
        show(target);
      });
    });

    const collect = () => ({
      role: pick('role') as Answers['role'],
      roleTitle: val('q-role-title') || undefined,
      changed: val('q-changed') || undefined,
      burn: val('q-burn') || undefined,
      tried: val('q-tried') || undefined,
      name: val('q-name'),
      email: val('q-email'),
      website: val('q-website'),
      websiteSource,
    });

    /* ----------------------------- reveal ----------------------------- */
    const reveal = (
      pane: 'booked' | 'error',
      opts: { bookingUrl?: string; email?: string } = {}
    ) => {
      form.hidden = true;
      head.hidden = true;
      const out = document.querySelector<HTMLElement>(`[data-out="${pane}"]`);
      if (out) out.hidden = false;
      if (out && pane !== 'error') {
        /* Their own words back to them, via textContent: this is visitor text. */
        if (opts.email) {
          out.querySelectorAll<HTMLElement>('[data-fill="email"]').forEach((el) => {
            el.textContent = opts.email as string;
          });
        }
      }
      if (pane === 'booked' && opts.bookingUrl) {
        mountScheduler($<HTMLDivElement>('#q-sched'), opts.bookingUrl);
        const alt = document.getElementById('q-sched-alt');
        if (alt) alt.hidden = false;
      }
      /* Scroll the outcome into view, not the top of a long page. */
      (out ?? form).scrollIntoView({ block: 'start', behavior: 'smooth' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrs();

      const a = collect();
      let bad = false;
      if (!a.name || !a.email || !a.website) {
        showErr('q-err-contact');
        bad = true;
      }
      if (bad) return;

      const submit = $<HTMLButtonElement>('#q-submit');
      submit.disabled = true;
      submit.textContent = 'Sending…';

      let attribution = {};
      try {
        attribution = JSON.parse(sessionStorage.getItem('ssl_attr') || '{}');
      } catch { /* best-effort */ }

      try {
        const res = await fetch('/api/intake', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...a, attribution }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        reveal('booked', {
          bookingUrl: data.bookingUrl,
          email: a.email,
        });
      } catch {
        /* Say what happened rather than pretend. A lost lead that the page
           called "on its way" is the worst outcome here. */
        reveal('error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Book the call';
      }
    });
  }
</script>
